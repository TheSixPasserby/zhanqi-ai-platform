# 使用国内镜像源安装依赖。
# 官方源在国内网络下单个包元数据请求可能要等 1–5 分钟，装一次 uni-app 要跑上百个包，
# 几乎不可能成功；换成 npmmirror 后整棵依赖树几十秒就能装完。
# 如果所在网络访问 npmmirror 反而更慢，把下面两行注释掉即恢复官方源。
registry=https://registry.npmmirror.com
disturl=https://registry.npmmirror.com/-/binary/node
sass_binary_site=https://registry.npmmirror.com/-/binary/node-sass

# uni-app 的依赖树里存在大量 historical 的 peer 冲突（vue2/vue3 混装），
# 用 legacy 模式安装，避免 npm 因 peer 校验直接报 ERESOLVE 退出。
legacy-peer-deps=true
audit=false
fund=false
